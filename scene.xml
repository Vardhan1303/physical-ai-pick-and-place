<mujoco model="pick_and_place_scene">
  <include file="assets/franka_emika_panda/panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="table_mat" rgba="0.55 0.4 0.28 1"/>
    <material name="square_mat" rgba="0.85 0.2 0.2 1"/>
    <material name="circle_mat" rgba="0.2 0.55 0.85 1"/>
    <material name="triangle_mat" rgba="0.25 0.75 0.35 1"/>
    <material name="bin_square_mat" rgba="0.85 0.2 0.2 0.35"/>
    <material name="bin_circle_mat" rgba="0.2 0.55 0.85 0.35"/>
    <material name="bin_triangle_mat" rgba="0.25 0.75 0.35 0.35"/>

    <texture type="2d" name="marker_square_tex" file="assets/markers/marker_square.png"/>
    <material name="marker_square_mat" texture="marker_square_tex" specular="0" shininess="0"/>
    <texture type="2d" name="marker_circle_tex" file="assets/markers/marker_circle.png"/>
    <material name="marker_circle_mat" texture="marker_circle_tex" specular="0" shininess="0"/>
    <texture type="2d" name="marker_triangle_tex" file="assets/markers/marker_triangle.png"/>
    <material name="marker_triangle_mat" texture="marker_triangle_tex" specular="0" shininess="0"/>

    <mesh name="triangular_prism" file="assets/meshes/triangular_prism.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <camera name="top_down" pos="0.5 0 1.0" xyaxes="1 0 0 0 1 0"/>

    <geom name="table" type="box" pos="0.5 0 0.2" size="0.3 0.35 0.2" material="table_mat"/>

    <geom name="bin_square" type="box" pos="0.75 -0.25 0.401" size="0.06 0.06 0.001" material="bin_square_mat" contype="0" conaffinity="0"/>
    <geom name="bin_circle" type="box" pos="0.75 0 0.401" size="0.06 0.06 0.001" material="bin_circle_mat" contype="0" conaffinity="0"/>
    <geom name="bin_triangle" type="box" pos="0.75 0.25 0.401" size="0.06 0.06 0.001" material="bin_triangle_mat" contype="0" conaffinity="0"/>

    <body name="obj_square" pos="0.4 -0.2 0.4">
      <freejoint/>
      <geom name="obj_square_geom" type="box" pos="0 0 0.02" size="0.02 0.02 0.02" material="square_mat" mass="0.05"/>
      <geom name="obj_square_marker" type="box" pos="0 0 0.0405" size="0.011 0.011 0.0005" material="marker_square_mat" contype="0" conaffinity="0"/>
    </body>

    <body name="obj_circle" pos="0.4 0 0.4">
      <freejoint/>
      <geom name="obj_circle_geom" type="cylinder" pos="0 0 0.02" size="0.02 0.02" material="circle_mat" mass="0.05"/>
      <geom name="obj_circle_marker" type="box" pos="0 0 0.0405" size="0.011 0.011 0.0005" material="marker_circle_mat" contype="0" conaffinity="0"/>
    </body>

    <body name="obj_triangle" pos="0.4 0.2 0.4">
      <freejoint/>
      <geom name="obj_triangle_geom" type="mesh" mesh="triangular_prism" material="triangle_mat" mass="0.05"/>
      <geom name="obj_triangle_marker" type="box" pos="0 0 0.0405" size="0.011 0.011 0.0005" material="marker_triangle_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>

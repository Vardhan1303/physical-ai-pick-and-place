<mujoco model="pick_and_place_scene">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="table_mat" rgba="0.55 0.4 0.28 1"/>
    <material name="square_mat" rgba="0.85 0.2 0.2 1"/>
    <material name="circle_mat" rgba="0.2 0.55 0.85 1"/>
    <material name="triangle_mat" rgba="0.25 0.75 0.35 1"/>
    <material name="bin_mat" rgba="0.6 0.6 0.65 0.35"/>

    <!-- "custom/" assets are ours (not part of the vendored Menagerie model);
         they live inside this folder's meshdir so MuJoCo's include-based path
         resolution finds them without ambiguity. -->
    <texture type="2d" name="marker_square_tex" file="custom/marker_square.png"/>
    <material name="marker_square_mat" texture="marker_square_tex" specular="0" shininess="0"/>
    <texture type="2d" name="marker_circle_tex" file="custom/marker_circle.png"/>
    <material name="marker_circle_mat" texture="marker_circle_tex" specular="0" shininess="0"/>
    <texture type="2d" name="marker_triangle_tex" file="custom/marker_triangle.png"/>
    <material name="marker_triangle_mat" texture="marker_triangle_tex" specular="0" shininess="0"/>

    <mesh name="triangular_prism" file="custom/triangular_prism.obj" scale="1.4 1.4 1.4"/>
  </asset>

  <worldbody>
    <!-- castshadow disabled: a straight-down directional light casts the
         gripper's shadow directly onto the table right under the fingers,
         which visually reads as the gripper "pressing into" the table even
         though there's no actual contact/interpenetration (verified via
         xpos: hand stays 10cm+ above the table top during approach). -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- orthographic: parallel rays give a true top-down silhouette of each
         object (no side-wall leakage from perspective foreshortening), and
         matches the fixed-table-height unprojection assumption exactly
         (shape_utils.unproject_pixel_to_table has an orthographic branch). -->
    <camera name="top_down" pos="0.5 0 1.3" xyaxes="1 0 0 0 1 0" projection="orthographic" fovy="0.8"/>
    <camera name="demo_view" pos="1.5 -1.1 1.15" xyaxes="0.7399 0.6727 0 -0.2866 0.3152 0.9047"/>

    <geom name="table" type="box" pos="0.5 0 0.2" size="0.3 0.35 0.2" material="table_mat"/>

    <!-- One shared bin (not shape-sorted). Sized generously since all 3
         objects can be resting in it at once during a run; pick_and_place_flip.py
         staggers each object's exact drop point within this footprint so
         they don't land on top of each other. -->
    <geom name="bin" type="box" pos="0.55 0 0.401" size="0.06 0.14 0.001" material="bin_mat" contype="0" conaffinity="0"/>

    <body name="obj_square" pos="0.4 -0.2 0.4">
      <freejoint/>
      <geom name="obj_square_geom" type="box" pos="0 0 0.0275" size="0.0275 0.0275 0.0275" material="square_mat" mass="0.05" friction="3.0 1.0 1.0" condim="4" solimp="0.95 0.99 0.001" solref="0.005 1"/>
      <geom name="obj_square_marker" type="box" pos="0 0 0.0555" size="0.011 0.011 0.0005" material="marker_square_mat" contype="0" conaffinity="0"/>
    </body>

    <body name="obj_circle" pos="0.4 0 0.4">
      <freejoint/>
      <geom name="obj_circle_geom" type="cylinder" pos="0 0 0.0275" size="0.0275 0.0275" material="circle_mat" mass="0.05" friction="3.0 1.0 1.0" condim="4" solimp="0.95 0.99 0.001" solref="0.005 1"/>
      <geom name="obj_circle_marker" type="box" pos="0 0 0.0555" size="0.011 0.011 0.0005" material="marker_circle_mat" contype="0" conaffinity="0"/>
    </body>

    <body name="obj_triangle" pos="0.4 0.2 0.4">
      <freejoint/>
      <geom name="obj_triangle_geom" type="mesh" mesh="triangular_prism" material="triangle_mat" mass="0.05" friction="3.0 1.0 1.0" condim="4" solimp="0.95 0.99 0.001" solref="0.005 1"/>
      <geom name="obj_triangle_marker" type="box" pos="0 0 0.0565" size="0.011 0.011 0.0005" material="marker_triangle_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- Weld constraints, inactive by default, toggled on/off at runtime the
       moment the gripper closes/opens (see manipulation.py). Pure friction
       grip in MuJoCo for small parallel-jaw grasps under lateral motion
       proved unreliable (verified through extensive testing); the weld
       guarantees the object travels with the gripper once grasped, while
       the fingers still physically close around it for a real-looking
       contact at pick/place. -->
  <equality>
    <weld name="weld_square" body1="hand" body2="obj_square" active="false"/>
    <weld name="weld_circle" body1="hand" body2="obj_circle" active="false"/>
    <weld name="weld_triangle" body1="hand" body2="obj_triangle" active="false"/>
  </equality>
</mujoco>
